# ===== Стадия 1: Сборка =====
FROM golang:1.25-alpine AS builder

# Установка необходимых системных пакетов
RUN apk add --no-cache git ca-certificates tzdata && \
    update-ca-certificates

# Создание рабочей директории
WORKDIR /app

# Копирование go.mod и go.sum для кэширования зависимостей
COPY go.mod go.sum ./

# Скачивание зависимостей (с учетом конкретной версии protos)
RUN go mod download && \
    go mod verify

# Копирование исходного кода
COPY . .

# Сборка бинарного файла
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-w -s" \
    -o /app/bin/api-gateway ./cmd/API_Service//main.go

# ===== Стадия 2: Финальный образ =====
FROM alpine:3.19

# Установка минимальных зависимостей
RUN apk add --no-cache ca-certificates tzdata

# Создание непривилегированного пользователя
RUN adduser -D -g '' appuser

# Копирование бинарного файла из стадии сборки
COPY --from=builder --chown=appuser:appuser /app/bin/api-gateway /app/api-gateway

# Копирование конфигов (если нужно)
COPY --from=builder --chown=appuser:appuser /app/config /app/config

# Копирование миграций (если нужно)
COPY --from=builder --chown=appuser:appuser /app/migrations /app/migrations

# Переключение на непривилегированного пользователя
USER appuser

# Рабочая директория
WORKDIR /app

# Открытие порта
EXPOSE 8080

# Проверка здоровья
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD ["/app/api-gateway", "health"] || exit 1

# Запуск приложения
ENTRYPOINT ["/app/api-gateway"]
CMD ["--config=./config/local.yaml"]
