FROM golang:1.25-alpine

RUN sed -i 's/dl-cdn.alpinelinux.org/mirror.yandex.ru/g' /etc/apk/repositories

RUN apk add --no-cache git ca-certificates

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

COPY ./config ./config

RUN go build -o api-gateway ./cmd/API_Service/main.go

RUN chmod +x api-gateway

RUN adduser -D -g '' appuser
RUN chown -R appuser:appuser /app

USER appuser

EXPOSE 8081 44000

CMD ["./api-gateway", "--config", "./config/local.yaml"]
